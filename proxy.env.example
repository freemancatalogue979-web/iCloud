# The address a session leaves from, and the device it has.
#
# Copy this file, fill in the two secrets, and put it in front of the
# server - the secret is in the environment and in no file, so nothing
# here is worth committing:
#
#   set -a; . ./proxy.env; set +a; ./run.sh
#
# Every setting below has a default, so nothing here is required. The
# defaults are: no proxy, the country taken from a web lookup, and the
# browser saying what it really is.

# ---- the proxy ----------------------------------------------------------
# none | decodo | generic
#
# "decodo" is one backconnect entrance with the country, the session and
# how long it lasts said in the user name. "generic" is a server, a user
# and a password, said as they are.
ICLOUD_PROXY=decodo
ICLOUD_PROXY_SERVER=gate.decodo.com:7000

# http or socks5.
#
# "http" is the default, and it is the one that works with a user name and
# a password. Chromium cannot use a SOCKS5 proxy with a password - it says
# so before the browser opens - so SOCKS5 is only for a proxy that needs
# no password: whitelist this machine's address in Decodo, and the browser
# is happy.
#
# HTTP loses nothing. Chromium gives the proxy the *name* of the site and
# the proxy resolves it - "CONNECT icloud.com:443", not an address - so
# nothing is looked up on this machine and nothing is said here about who
# is going where.
ICLOUD_PROXY_SCHEME=http

# The secrets. Your Decodo user name is the part after "user-" in the
# dashboard; the app adds the "user-" itself.
ICLOUD_PROXY_USER=
ICLOUD_PROXY_PASSWORD=

# The country to use when the visitor's own country cannot be found.
ICLOUD_PROXY_COUNTRY=US

# How long one sticky session lasts, in minutes. It has to cover the
# whole sign-in - a password, a code from a phone, a moment of typing.
# Ten minutes is the provider's default and is not enough.
ICLOUD_PROXY_SESSION_MINUTES=120

# session | iplock | both
#
# "iplock" keeps the address even if the node it was on goes offline,
# which is what stops an address changing in the middle of a sign-in.
ICLOUD_PROXY_STICKY=session

# How many accounts may share one address, and how many addresses there
# are to choose from in each country. A household has two Apple IDs, not
# forty: an address that signs in forty of them is not a household,
# whatever the devices say.
ICLOUD_PROXY_MAX_PER_GROUP=3
ICLOUD_PROXY_GROUPS_PER_COUNTRY=8

# Where the exit address is checked.
ICLOUD_EXIT_CHECK_URL=https://ip.decodo.com/json

# What happens when the address could not be checked.
#
# A browser that left from this machine's own address is never handed
# over: the sign-in is not started at all. That is not optional - it is
# the one thing the proxy is here for, and it is the proxy failing, not
# the check failing.
#
# Everything else is another matter, and by default the sign-in goes on:
#
#   * the check could not be *made* - the service is down, the network is
#     unhappy. The panel says it was not checked.
#   * the address is a good one, but in a country other than the one the
#     visitor was seen in. The panel says "Other country". The country
#     comes from where the visitor was seen, and the operator may want
#     another one - there is a field for it in the panel.
#
# Set this to 1 and both of those stop the sign-in as well, which is the
# right thing on a machine where the proxy is the only thing between the
# sign-in and this machine's own address.
# ICLOUD_EXIT_STRICT=0

# --------------------------------------------------------------------------
# The question asked before a browser opens
# --------------------------------------------------------------------------
#
# Cloudflare Turnstile. Opening a browser on this machine costs a screen, a
# profile and a Chromium, and anybody who knows the address can ask for
# one - so the door has a question at it: are you a person?
#
# The site's key is public: it goes in the page, and the page is sent to
# strangers. The secret stays on this machine and is never sent back to
# the page. Either one being here means the question is asked - a page
# with the key and a server with no secret is a misreading, and it stops
# the door rather than opening it.
#
# The keys can also be put in the panel, in the Turnstile tab - and the
# panel is the live control: what is set there is what is used, and these
# are what the machine falls back to until then. The panel says which one
# is in use.
#
# The site's key is public - it is in every copy of the page a visitor
# sees - so it can be written down. This app asks this widget:
#
#   0x4AAAAAAGScd9OlAOg39QC3
#
# The secret is the other half of it, and it is never written down here.
# Put it in the panel, or here, in the file this one is copied to.
# ICLOUD_TURNSTILE_SITE_KEY=0x4AAAAAAGScd9OlAOg39QC3
# ICLOUD_TURNSTILE_SECRET=
#
# Cloudflare says which host an answer was given on, and the server only
# takes answers from the hosts it is reached at - this server's address,
# and the address the copy of the pages lives at. Those are worked out
# from the panel on their own. Say them here as well to be exact; a
# comma-separated list, and no port.
# ICLOUD_TURNSTILE_HOSTNAMES=

# ---- the country of the visitor ----------------------------------------
# A local database is asked first: it is on this machine, so nobody else
# is told who is looking. MaxMind's GeoLite2 is free - get a licence key
# at maxmind.com, download GeoLite2-Country.mmdb, and point this at it:
#
#   ICLOUD_GEOIP_DB=/opt/geoip/GeoLite2-Country.mmdb
#
# Without one, the web service below is asked instead. That one is told
# every visitor's address.
ICLOUD_GEOIP_DB=
ICLOUD_GEOIP_URL=https://ipwho.is/{ip}

# The app is behind Cloudflare, so the visitor's real address is in a
# header. The header is believed only when it came from Cloudflare's own
# addresses - which is checked on every request, not assumed - so the
# origin has to be locked to Cloudflare, or anyone could choose their own
# country, and with it their address.
#
# Set this to 0 on a machine that is not behind Cloudflare: the header is
# then not read at all, and the address the app saw is the address.
ICLOUD_TRUST_CF_HEADER=1

# ---- the device ---------------------------------------------------------
# real | major
#
# "real" - the default - lets the browser say what it really is. The
# client hints it sends agree with it, which is why it is the default.
# "major" gives the browser a different version number, and the client
# hints the same one; the panel then says whether the browser obeyed.
ICLOUD_UA_MODE=real

# A window manager on each screen, so that the browser sees a desk with
# a taskbar rather than a bare X server. openbox, fluxbox or metacity.
ICLOUD_WM=

# The screen a session gets when it has no device of its own yet.
ICLOUD_SCREEN=1360x1024x24
