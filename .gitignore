# The browsers' profiles: one per visitor, and their memory.
visitors/
profiles/

# The groups: which visitor shares which address, and the address each
# group was last seen leaving from.
state/

# The control room's settings: the admin secret, the Telegram token and the
# chat id, and the sessions whose cookies may be exported. It is a secret
# file, and it is never in the repository.
admin.json
admin.tmp

# The cookies of the sessions that signed in, kept so that they can be read
# when their browser is not open. A secret file per client (0600), and never
# in the repository.
cookies/

# Playwright's browsers, and the Python cache.
.venv/
__pycache__/
node_modules/
