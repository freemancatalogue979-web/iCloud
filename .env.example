# iCloud Browser Console — configuration
#
# Copy to `.env` and adjust. Every value is optional; these are the defaults.
#
# IMPORTANT: there is deliberately NO variable for an Apple ID or password.
# This project drives a browser to icloud.com and then hands the sign-in page
# to a human. It never stores, types, or transmits Apple credentials.

# --- Server ---------------------------------------------------------------
ICLOUD_HOST=0.0.0.0
ICLOUD_PORT=8000

# --- Browser --------------------------------------------------------------
# "playwright" (primary) or "selenium" (fallback)
ICLOUD_DRIVER=playwright

# Headed is the default on purpose: a human must be able to complete the
# Apple sign-in and any two-factor prompt in the real window.
ICLOUD_HEADLESS=false

# Persistent profile so you sign in once and the session is reused.
ICLOUD_PROFILE_DIR=.profile/icloud

ICLOUD_NAV_TIMEOUT_MS=30000
ICLOUD_SIGNIN_WAIT_SECONDS=180

# Optional: path to a system Chrome/Chromium, if you do not want the
# Playwright-managed download.
# ICLOUD_BROWSER_EXECUTABLE=/usr/bin/chromium
