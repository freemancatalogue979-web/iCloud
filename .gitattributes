# Keep Windows batch files on CRLF — cmd.exe can mis-parse LF-only .bat files.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Shell scripts must stay LF or bash on Linux/macOS will choke on \r.
*.sh    text eol=lf

# Python and web assets: normalise to LF in the repo.
*.py    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf

# Never touch binaries.
*.png   binary
*.ico   binary
